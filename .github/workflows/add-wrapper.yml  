name: Add Gradle Wrapper
on: workflow_dispatch          # دستی اجرا می‌شود، نه خودکار
permissions:
  contents: write
jobs:
  wrapper:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with: { distribution: temurin, java-version: 17 }
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: 8.10 }
      - run: gradle wrapper --gradle-version 8.10 --distribution-type bin
      - uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "chore(ci): add Gradle wrapper 8.10 (fix INF-CI-1)"
